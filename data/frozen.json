 "TIPS": {
  "<th>Committed</th>": "Story points already in the sprint the day it started.",
  "<th>Added</th>": "Story points pulled into the sprint after it had already started.",
  "<th>Completed</th>": "Story points that reached a Done status before the sprint closed.",
  "<th>Left sprint</th>": "Story points that did not finish inside the sprint: removed before it closed, or still open at close. Jira moves them out, which is why the burndown can reach zero.",
  "<th>vs commit</th>": "Completed divided by the day-1 commitment. Above 100% means the sprint delivered more than it set out to.",
  "<th>Added: reactive</th>": "Points added mid-sprint carrying a reactive marker: labeled Unplanned, or typed Urgent Task.",
  "<th>Added: plannable</th>": "Points added mid-sprint with no reactive marker — work that could have been planned in from day 1.",
  "<th>% reactive</th>": "Reactive points as a share of everything added after day 1.",
  "<td>Throughput (closed)</td>": "Items that reached Closed during the month. Sub-tasks and epics excluded; discarded work is not counted.",
  "<td>Unplanned work</td>": "Share of the month’s closed items labeled Unplanned. Target is 5% or below.",
  "<td>Cycle Time (median)</td>": "Calendar days from the first entry into In Development until closure, median across the month.",
  "<td>Closed without entering development</td>": "Items closed without ever recording a transition into In Development. They have no Cycle Time, so they sit outside that metric.",
  "<td>Discarded (Won't Do)</td>": "Resolved as Won’t Do. Counted separately because discarded work is not delivered work.",
  "<div class=\"k\">Committed at start</div>": "Story points in the sprint on day 1, before anything was added.",
  "<div class=\"k\">Added during sprint</div>": "Story points pulled in after the sprint started. For a service team some of this is unavoidable.",
  "<div class=\"k\">Completed</div>": "Story points closed inside the sprint window.",
  "<div class=\"k\">vs commitment</div>": "Completed against the day-1 commitment, not against final scope.",
  "<span class=\"gname\">Throughput</span>": "Items closed per month. Measures delivery capacity, not effort or complexity.",
  "<span class=\"gname\">Cycle Time</span>": "How long an item takes from the moment work starts until it closes, in calendar days.",
  "<span class=\"gname\">Planned vs Unplanned</span>": "Share of delivered work that was reactive. Measures predictability, not productivity.",
  "<span class=\"gname\">Work In Progress · current snapshot</span>": "Items sitting in In Development or Awaiting Review right now. Policy is 2 per developer, with review at half that.",
  "<span class=\"gname\">Work In Progress</span>": "Items in In Development or Awaiting Review. A point-in-time reading, not a monthly total.",
  "<span class=\"gname\">Delivered vs discarded</span>": "Closed items against those resolved as Won’t Do in the same month."
 },
